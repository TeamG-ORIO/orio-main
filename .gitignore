# ORIO .gitignore — never track build products, bytecode, logs, or editor cruft.

# --- ROS / catkin build products ---
build/
build_isolated/
devel/
devel_isolated/
install/
.catkin_workspace

# --- Logs ---
logs/
*.log
logging/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# --- Data / runtime artifacts ---
data/**
!data/.gitkeep
dataset/
*.npy
*.bag

# --- ML model weights (huge; download at setup, never commit) ---
*.pth
*.pt
*.ckpt
*.ckpt.*
*.onnx

# --- SQLite ---
# Ignore mutable runtime DBs; track only the canonical seed. db_manager seeds the
# runtime copy from seed_medical_inventory.db on first run (see orio_rfid).
*.db
*.sqlite
*.sqlite3
!src/devel_packages/orio_rfid/seed_medical_inventory.db

# --- Regenerable debug captures ---
depth_image.png
depth_raw.npy
rgb_image.png

# --- Editor / OS cruft ---
.vscode/
.idea/
*.swp
*.swo
*~
__MACOSX/
.DS_Store

# frankapy: per-machine client, git-ignored (see orio_bringup README).
src/git_packages/frankapy/

# research/prm: local only, not pushed
research/prm/

# Extracted ROS Noetic dist-packages for the dexnet container (see run_dexnet.sh)
.ros_noetic_dist/

# Local credentials (Franka Desk user/password etc). Never commit — see COMMANDS.md.
.env.local

# --- Claude Code worktree copies (never commit) ---
.claude/worktrees/

# --- orio_rfid item localiser: the trained models and the demo map's point cloud are needed to run it ---
!src/devel_packages/orio_rfid/loc/models/*.pt
!src/devel_packages/orio_rfid/loc/site/*.npy

# --- orio_rfid: kept on the machines only (this repo is public) ---
# addresses of the robot and the PC (copy demo.conf.example), the reader's recovery note with its login
src/devel_packages/orio_rfid/demo/demo.conf
src/devel_packages/orio_rfid/RFID/RFID_RECOVER_FROM_RESET.md
# reader test recordings, tag registry backups, the vendor's PDF
src/devel_packages/orio_rfid/RFID/pass_logs/
src/devel_packages/orio_rfid/RFID/t2_logs/
src/devel_packages/orio_rfid/RFID/tag_registry.csv.bak_*
src/devel_packages/orio_rfid/RFID/docs/
