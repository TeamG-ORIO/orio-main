<launch>
    <!-- Both cameras at once. NOTE: launching ZED + Xtion simultaneously makes them contend
         for USB Bus 001 bandwidth (the ZED-M HID interface shares that bus with the Xtion),
         which flaps the Xtion at startup. For staggered, contention-free bring-up prefer
         zed_only.launch then xtion_only.launch (what run_dexnet_pnp_single.sh does). This
         combined file is kept for callers that want one launch and can tolerate the retry.
         See docs/TROUBLESHOOTING.md: "Xtion flaps at bring-up: USB bus contention". -->
    <include file="$(find manipulation)/launch/zed_only.launch" />
    <include file="$(find manipulation)/launch/xtion_only.launch" />
</launch>
