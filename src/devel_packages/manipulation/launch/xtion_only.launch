<launch>
    <!-- Xtion (ASUS PrimeSense) only. Split out of cameras.launch so bring-up can start it
         AFTER the ZED has settled — see zed_only.launch for why (USB Bus 001 contention).
         depth_registration aligns depth to the RGB frame (needed downstream). -->
    <include file="$(find openni2_launch)/launch/openni2.launch">
        <arg name="depth_registration" value="true" />
    </include>
</launch>
