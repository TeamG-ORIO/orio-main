<launch>
    <!-- Grasp backend + camera config for the combined perception node. -->
    <arg name="grasp_backend" default="" doc="override grasp.yaml: suction | dexnet | classical"/>
    <arg name="load_labelling_models" default="false"
         doc="load SAM/GroundingDINO even for a planner backend, so /compute_grasps_labelling works"/>

    <node name="combined_perception_node" pkg="orio_perception"
          type="perception_control_combined_pass_through.py" output="screen">
        <rosparam command="load" file="$(find orio_perception)/config/grasp.yaml"/>
        <param name="grasp_backend" value="$(arg grasp_backend)" if="$(eval arg('grasp_backend') != '')"/>
        <param name="load_labelling_models" value="$(arg load_labelling_models)"/>
    </node>
</launch>
